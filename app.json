{
  "expo": {
    "name": "Mersal Media",
    "icon": "./assets/design/app-icon.png",
    "slug": "mersal-media",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "mersalmedia",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mersalmedia.studio"
    },
    "android": {
      "package": "com.mersalmedia.studio",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3FAFB",
          "image": "./assets/design/brand-logo.png",
          "imageWidth": 88,
          "resizeMode": "contain"
        }
      ],
      [
  "expo-build-properties",
  {
    "android": {
      "buildArchs": ["arm64-v8a"],
      "enableMinifyInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true,
      "useLegacyPackaging": true
    }
  }
],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-audio",
      "expo-image",
      "expo-build-properties"
    ],
    "web": {
      "name": "Mersal Media"
    },
    "extra": {
      "eas": {
        "projectId": "c49c398a-d88a-4ca8-b731-8551b55b8d60"
      }
    }
  }
}
